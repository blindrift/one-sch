generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

/// 가입 상태. 구글 첫 로그인은 PENDING 으로 만들어 관리자가 승인(APPROVED)·거부(REJECTED)한다.
/// PENDING·REJECTED 는 항상 active=false 이다(세션·로그인·담당자 목록은 active 만 본다).
enum UserApproval {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum DependencyType {
  FS
}

enum IssueType {
  ISSUE
  RISK
  REQUEST
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// email 과 username 중 하나는 반드시 있다(CHECK, 마이그레이션 수기 추가).
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// 구글 SSO 매칭 키(소문자)
  email              String?   @unique
  /// 로컬 로그인 아이디(소문자)
  username           String?   @unique
  emailVerified      DateTime? @db.Timestamptz(6)
  image              String?
  name               String
  role               Role      @default(VIEWER)
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  active             Boolean   @default(true)
  approval           UserApproval @default(APPROVED)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(6)
  lastLoginAt        DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  accounts       Account[]
  sessions       Session[]
  ownedProjects  Project[]  @relation("ProjectOwner")
  assignedTasks  Task[]     @relation("TaskAssignee")
  assignedIssues Issue[]    @relation("IssueAssignee")
  reportedIssues Issue[]    @relation("IssueReporter")
  comments       Comment[]
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// sessionToken 은 원본 토큰의 SHA-256 hex. 원본은 쿠키에만 있다.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  lastSeenAt   DateTime @default(now()) @db.Timestamptz(6)
  ip           String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String        @id @default(uuid()) @db.Uuid
  key       String        @unique @db.VarChar(10)
  name      String
  color     String        @db.Char(7)
  status    ProjectStatus @default(PLANNED)
  startDate DateTime?     @db.Date
  endDate   DateTime?     @db.Date
  ownerId   String        @db.Uuid
  archived  Boolean       @default(false)
  /// 이슈 번호 발급용 카운터
  issueSeq  Int           @default(0)
  /// 낙관적 잠금(동시 편집 충돌 감지)
  version   Int           @default(0)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)

  owner  User    @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tasks  Task[]
  issues Issue[]

  @@index([ownerId])
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  parentId    String?    @db.Uuid
  title       String
  startDate   DateTime   @db.Date
  endDate     DateTime   @db.Date
  progress    Int        @default(0) @db.SmallInt
  status      TaskStatus @default(TODO)
  assigneeId  String?    @db.Uuid
  isMilestone Boolean    @default(false)
  sortOrder   Int        @default(0)
  version     Int        @default(0)
  /// 관련 링크 하나(http/https, 2000자 이하 — 0003 의 CHECK)
  url         String?
  /// 여러 줄 평문 메모(5000자 이하 — 0003 의 CHECK)
  memo        String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     Task?            @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   Task[]           @relation("TaskHierarchy")
  assignee   User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependsOn  TaskDependency[] @relation("DependencyTo")
  dependedBy TaskDependency[] @relation("DependencyFrom")
  issues     Issue[]

  @@index([projectId, sortOrder])
  @@index([assigneeId])
  @@index([parentId])
}

model TaskDependency {
  id         String         @id @default(uuid()) @db.Uuid
  fromTaskId String         @db.Uuid
  toTaskId   String         @db.Uuid
  type       DependencyType @default(FS)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  fromTask Task @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId])
  @@index([toTaskId])
}

model Issue {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  number      Int
  taskId      String?       @db.Uuid
  title       String
  description String        @default("")
  type        IssueType     @default(ISSUE)
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  assigneeId  String?       @db.Uuid
  reporterId  String        @db.Uuid
  dueDate     DateTime?     @db.Date
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assignee User?     @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User      @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  comments Comment[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([taskId])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  issueId   String    @db.Uuid
  authorId  String    @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
}

/// append-only: 앱 역할은 UPDATE/DELETE 권한이 없고 트리거가 모두 거부한다.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now()) @db.Timestamptz(6)
  actorId   String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([at])
  @@index([entity, entityId])
  @@index([actorId, at])
}

/// IP 단위 로그인 시도 기록(분당 제한용)
model LoginAttempt {
  id      BigInt   @id @default(autoincrement())
  ip      String
  at      DateTime @default(now()) @db.Timestamptz(6)
  success Boolean  @default(false)

  @@index([ip, at])
}
