# one-sch 환경 변수 틀. 이 파일을 복사해 값을 채운다(값이 든 파일은 git 에 올리지 않는다).
#
#   운영(NAS docker compose):  cp .env.example .env.prod   → scripts/prod.sh 가 읽는다
#   개발·테스트(로컬):          cp .env.example .env.local  → npm run db:up, 통합·E2E 테스트가 읽는다
#
# 비밀번호·키 만들기:
#   DB 비밀번호 4종  openssl rand -hex 24
#   AUTH_SECRET      openssl rand -base64 32
#
# 주의
# - 아래 *_DATABASE_URL 의 <...> 자리에는 실제 비밀번호 값을 그대로 넣는다.
#   ${APP_DB_PASSWORD} 같은 참조는 docker compose 는 치환하지만 Node(process.loadEnvFile)는 치환하지 않는다.
# - 셸에 같은 이름의 변수가 export 돼 있으면 파일 값이 무시된다.
# - hex 비밀번호를 쓰면 URL 인코딩이 필요 없다(특수문자를 쓰면 URL 에서는 %인코딩).

# ─────────────────────────────────────────────
# 공통: DB 역할 비밀번호 (운영·개발 모두 필요)
# ─────────────────────────────────────────────
# postgres 슈퍼유저(역할·DB 생성, 테스트 DB 정리용)
POSTGRES_PASSWORD=
# 앱 실행 역할 onesch_app (데이터 읽기·쓰기)
APP_DB_PASSWORD=
# 마이그레이션 역할 onesch_owner (스키마 변경)
MIGRATOR_DB_PASSWORD=
# 백업 역할 onesch_backup (pg_dump 읽기 전용)
BACKUP_DB_PASSWORD=

# ─────────────────────────────────────────────
# 인증 (Auth.js)
# ─────────────────────────────────────────────
# 세션 서명 키. 운영과 개발은 서로 다른 값을 쓴다.
AUTH_SECRET=
# 사용자가 접속하는 주소. 운영 예: https://sch.example.com  개발: http://localhost:3000
AUTH_URL=http://localhost:3000
# 구글 OAuth 클라이언트(선택). 비워도 앱은 뜨고, 구글 로그인 버튼만 동작하지 않는다.
# 구글 콘솔의 승인된 리디렉션 URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 아이디·비밀번호(로컬) 로그인 허용. 구글 ADMIN 계정이 준비되면 운영에서는 false 권장.
LOCAL_LOGIN_ENABLED=true

# ─────────────────────────────────────────────
# 운영 전용 (.env.prod)
# ─────────────────────────────────────────────
# 리버스 프록시가 넣어 주는 실제 클라이언트 IP 헤더(DSM 리버스 프록시는 x-real-ip). 로그인 속도 제한·감사 IP 에 쓴다.
CLIENT_IP_HEADER=x-real-ip
# 실행할 이미지 태그(one-sch-app:<태그>, one-sch-migrate:<태그>). 비우면 latest.
APP_VERSION=

# ─────────────────────────────────────────────
# 개발·테스트 전용 (.env.local) — 개발 DB 는 compose.dev.yml 이 127.0.0.1:5433 에 띄운다
# ─────────────────────────────────────────────
# 앱이 쓰는 DB(onesch_app 역할)
DATABASE_URL=postgresql://onesch_app:<APP_DB_PASSWORD>@127.0.0.1:5433/onesch?schema=public
# 마이그레이션(onesch_owner 역할). npm run db:reset 등이 DATABASE_URL 대신 쓴다.
MIGRATE_DATABASE_URL=postgresql://onesch_owner:<MIGRATOR_DB_PASSWORD>@127.0.0.1:5433/onesch?schema=public
# 통합 테스트 DB. E2E 는 DB 이름을 onesch_e2e 로 바꿔 쓴다(자동).
TEST_DATABASE_URL=postgresql://onesch_app:<APP_DB_PASSWORD>@127.0.0.1:5433/onesch_test?schema=public
TEST_MIGRATE_DATABASE_URL=postgresql://onesch_owner:<MIGRATOR_DB_PASSWORD>@127.0.0.1:5433/onesch_test?schema=public
# 테스트 DB 정리 전용(postgres 슈퍼유저)
TEST_ADMIN_DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/onesch_test?schema=public
