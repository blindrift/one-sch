{
  "name": "one-sch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose --env-file .env.local -f compose.dev.yml up -d --wait",
    "db:migrate": "node scripts/with-migrate-url.mjs prisma migrate dev",
    "db:reset": "docker compose --env-file .env.local -f compose.dev.yml down -v && npm run db:up && node scripts/with-migrate-url.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-migrate-url.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@svar-ui/react-core": "2.6.2",
    "@svar-ui/react-gantt": "2.8.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.77.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "prisma": "6.19.3",
    "radix-ui": "1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    },
    "effect": "3.22.5",
    "deepmerge-ts": "8.0.2"
  }
}
