{
  "name": "one-sch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f compose.dev.yml up -d",
    "db:migrate": "node scripts/with-migrate-url.mjs prisma migrate dev",
    "db:reset": "node scripts/with-migrate-url.mjs prisma migrate reset --force",
    "db:seed": "node scripts/with-migrate-url.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "prisma": "6.19.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
